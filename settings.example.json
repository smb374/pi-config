{
  "lastChangelogVersion": "0.85.1",
  "theme": "catppuccin-mocha",
  "defaultProvider": "<provider>",
  "defaultModel": "<model>",
  "defaultThinkingLevel": "<level>",
  "defaultTools": [
    "+codemode"
  ],
  "packages": [
    "npm:pi-better-edit",
    "npm:pi-commandcode-provider",
    "npm:pi-context-view",
    "npm:pi-jingle",
    "npm:pi-workspace-history",
    "npm:pi-zentui",
    "npm:@arhen/pi-core-todo",
    "npm:@ff-labs/pi-fff",
    "npm:@firstpick/pi-themes-bundle",
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:@gotgenes/pi-nocd",
    "npm:@gotgenes/pi-permission-system",
    "npm:@gotgenes/pi-subagents",
    "npm:@juicesharp/rpiv-web-tools",
    "npm:@narumitw/pi-btw",
    "npm:@narumitw/pi-goal",
    "npm:@narumitw/pi-lsp",
    "npm:@narumitw/pi-tool",
    "npm:@narumitw/pi-usage",
    "npm:@sting8k/pi-vcc",
    "npm:@xynogen/pix-optimizer"
  ],
  "npmCommand": [
    "bun"
  ],
  "showHardwareCursor": true,
  "tuiMode": "fullscreen",
  "hideThinkingBlock": true,
  "doubleEscapeAction": "tree",
  "treeFilterMode": "all",
  "markdown": {
    "mermaid": "streaming"
  },
  "subagentsDefaultProfile": "<profile>",
  "editorPaddingX": 0,
  "quietStartup": "header",
  "enabledModels": [
    "<provider1>/<model1>",
    "<provider2>/<model2>",
    "<provider3>/<model3>"
  ]
}
