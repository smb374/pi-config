{
  "lastChangelogVersion": "0.85.1",
  "theme": "pix-catppuccin-mocha",
  "defaultProvider": "<provider>",
  "defaultModel": "<model>",
  "defaultThinkingLevel": "<level>",
  "packages": [
    "npm:pi-better-edit",
    "npm:pi-blackhole",
    "npm:pi-commandcode-provider",
    "npm:pi-context-view",
    "npm:pi-jingle",
    "npm:pi-mcp-extension",
    "npm:pi-zentui",
    "npm:pi-workspace-history",
    "npm:@arhen/pi-core-todo",
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:@gotgenes/pi-subagents",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-web-tools",
    "npm:@narumitw/pi-btw",
    "npm:@narumitw/pi-goal",
    "npm:@narumitw/pi-lsp",
    "npm:@narumitw/pi-tool",
    "npm:@narumitw/pi-usage",
    "npm:@xynogen/pix-find",
    "npm:@xynogen/pix-grep",
    "npm:@xynogen/pix-optimizer",
    "npm:@xynogen/pix-themes",
    "git:github.com/smb374/pi-subagents-plus"
  ],
  "showHardwareCursor": true,
  "tuiMode": "fullscreen",
  "hideThinkingBlock": true,
  "doubleEscapeAction": "tree",
  "treeFilterMode": "all",
  "markdown": {
    "mermaid": "streaming"
  },
  "editorPaddingX": 0,
  "quietStartup": true,
  "enabledModels": [
    "<provider1>/<model1>",
    "<provider2>/<model2>",
    "<provider3>/<model3>"
  ]
}
