{
  "lastChangelogVersion": "1.2.0",
  "theme": "catppuccin-mocha",
  "defaultProvider": "<provider>",
  "defaultModel": "<model>",
  "defaultThinkingLevel": "<level>",
  "defaultAgentProfile": "<profile>",
  "defaultTools": [
    "+codemode"
  ],
  "packages": [
    "npm:pi-better-edit",
    "npm:pi-commandcode-provider",
    "npm:pi-context-view",
    "npm:pi-herdsman",
    "npm:pi-workspace-history",
    "npm:@ff-labs/pi-fff",
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:@gotgenes/pi-nocd",
    "npm:@gotgenes/pi-permission-system",
    "npm:@inobit/pi-themes",
    "npm:@juicesharp/rpiv-web-tools",
    "npm:@narumitw/pi-btw",
    "npm:@narumitw/pi-lsp",
    "npm:@pi-archimedes/notify",
    "npm:@pi-archimedes/todo",
    "npm:@schovest/pi-goal",
    "npm:@sting8k/pi-vcc",
    "npm:@tmustier/pi-usage-extension",
    "npm:@xynogen/pix-optimizer"
  ],
  "npmCommand": [
    "bun"
  ],
  "showHardwareCursor": true,
  "tuiMode": "fullscreen",
  "hideThinkingBlock": true,
  "doubleEscapeAction": "tree",
  "treeFilterMode": "all",
  "markdown": {
    "mermaid": "streaming"
  },
  "editorPaddingX": 0,
  "quietStartup": "header",
  "codemode": {
    "mode": "only",
    "inlineBudget": 6000
  },
  "archimedes.notify": {
    "delayMs": 10000
  },
  "loopbackMcp": {
    "<name>": {
      "url": "http://<host>:<port>/mcp",
      "port": 8081
    }
  },
  "enabledModels": [
    "<provider1>/<model1>",
    "<provider2>/<model2>",
    "<provider3>/<model3>"
  ]
}
