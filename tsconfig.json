{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": ["scripts/**/*.ts", "extensions/**/*.ts", "patches/**/*.ts"],
  "exclude": ["extensions/pi-permission-system", "node_modules"]
}
