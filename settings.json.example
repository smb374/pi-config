{
  "lastChangelogVersion": "0.85.1",
  "theme": "catppuccin-mocha",
  "defaultProvider": "<provider>",
  "defaultModel": "<model>",
  "defaultThinkingLevel": "<level>",
  "packages": [
    "npm:pi-blackhole",
    "npm:pi-commandcode-provider",
    "npm:pi-context-view",
    "npm:pi-hashline-edit-pro",
    "npm:pi-jingle",
    "npm:pi-mcp-extension",
    "npm:pi-open-tui",
    "npm:pi-rtk-optimizer",
    "npm:pi-subagents",
    "npm:pi-workspace-history",
    "npm:@arhen/pi-core-ask",
    "npm:@arhen/pi-core-todo",
    "npm:@arhen/pi-core-tps-stats",
    "npm:@narumitw/pi-btw",
    "npm:@narumitw/pi-goal",
    "npm:@narumitw/pi-lsp",
    "npm:@narumitw/pi-plan-mode",
    "npm:@narumitw/pi-usage",
    "npm:@juicesharp/rpiv-web-tools",
    "npm:@ifi/oh-pi-themes",
    "git:github.com/elpapi42/pi-fork"
  ],
  "npmCommand": [
    "bun"
  ],
  "showHardwareCursor": true,
  "tuiMode": "fullscreen",
  "hideThinkingBlock": true,
  "doubleEscapeAction": "tree",
  "treeFilterMode": "all",
  "markdown": {
    "mermaid": "streaming"
  },
  "editorPaddingX": 0,
  "quietStartup": true,
  "subagents": {
  },
  "enabledModels": [
    "<provider1>/<model1>",
    "<provider2>/<model2>",
    "<provider3>/<model3>"
  ]
}
