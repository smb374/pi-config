{
  "authorizerChain": ["jev"],
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny"
    },
    "bash": {
      "*": "ask",

      "cd *": "allow",
      "pwd": "allow",
      "ls *": "allow",
      "tree *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "du *": "allow",
      "df *": "allow",
      "wc *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "diff *": "allow",
      "jq *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "realpath *": "allow",
      "which *": "allow",
      "command -v *": "allow",
      "type *": "allow",
      "date *": "allow",
      "uname *": "allow",
      "whoami": "allow",
      "ps *": "allow",
      "mkdir *": "allow",

      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git blame *": "allow",
      "git shortlog *": "allow",
      "git reflog *": "allow",
      "git describe *": "allow",
      "git rev-parse *": "allow",
      "git ls-files *": "allow",
      "git merge-base *": "allow",
      "git cat-file *": "allow",
      "git config --get *": "allow",
      "git branch": "allow",
      "git branch --show-current": "allow",
      "git branch -a": "allow",
      "git branch -r": "allow",
      "git branch -v": "allow",
      "git branch -vv": "allow",
      "git branch --list *": "allow",
      "git tag": "allow",
      "git tag --list *": "allow",
      "git remote": "allow",
      "git remote -v": "allow",
      "git worktree list *": "allow",
      "git stash list *": "allow",
      "git stash show *": "allow",
      "git fetch *": "allow",
      "git add *": "allow",
      "git commit *": "allow",

      "gh pr view *": "allow",
      "gh pr list *": "allow",
      "gh pr diff *": "allow",
      "gh pr checks *": "allow",
      "gh issue view *": "allow",
      "gh issue list *": "allow",
      "gh run view *": "allow",
      "gh run list *": "allow",
      "gh repo view *": "allow",

      "just *": "allow",
      "make *": "allow",

      "shellcheck *": "allow",
      "shfmt *": "allow",

      "rm -rf /tmp/*": "allow",
      "rm -r /tmp/*": "allow",
      "rm -f /tmp/*": "allow",
      "rm /tmp/*": "allow",

      "grep *": {"action": "deny", "reason": "Use the grep tool"},
      "egrep *": {"action": "deny", "reason": "Use the grep tool"},
      "fgrep *": {"action": "deny", "reason": "Use the grep tool"},
      "git grep *": {"action": "deny", "reason": "Use the grep tool"},
      "find *": {"action": "deny", "reason": "Use the find tool"},
      "sed *": {"action": "deny", "reason": "Use the edit tool, or read for viewing"},
      "awk *": {"action": "deny", "reason": "Use read/grep, or a real script"},
      "echo *": {"action": "deny", "reason": "Write prose in your reply, not via echo"}
    }
  }
}
