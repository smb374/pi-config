{{! defaultProvider: Main model provider (e.g. anthropic) | default=anthropic }}
{{! defaultModel: Main model id | default=claude-opus-4-5 }}
{{! defaultThinkingLevel: Thinking level (off|minimal|low|medium|high|xhigh) | default=high }}
{{! subagentsDefaultProfile: Subagent profile from profiles/ | default=home }}
{
  "theme": "catppuccin-mocha",
  "defaultProvider": "{{{defaultProvider}}}",
  "defaultModel": "{{{defaultModel}}}",
  "defaultThinkingLevel": "{{{defaultThinkingLevel}}}",
  "subagentsDefaultProfile": "{{{subagentsDefaultProfile}}}",
  "defaultTools": [
    "+codemode"
  ],
  "extensions": [
    "-builtin:usage"
  ],
  "packages": [
    "npm:pi-better-edit",
    "npm:pi-commandcode-provider",
    "npm:pi-context-view",
    "npm:pi-workspace-history",
    "npm:@ff-labs/pi-fff",
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:@gotgenes/pi-nocd",
    "npm:@gotgenes/pi-permission-system",
    "npm:@gotgenes/pi-subagents",
    "npm:@inobit/pi-themes",
    "npm:@juicesharp/rpiv-web-tools",
    "npm:@narumitw/pi-btw",
    "npm:@narumitw/pi-lsp",
    "npm:@pi-archimedes/notify",
    "npm:@pi-archimedes/todo",
    "npm:@schovest/pi-goal",
    "npm:@sting8k/pi-vcc",
    "npm:@tmustier/pi-usage-extension",
    "npm:@xynogen/pix-optimizer"
  ],
  "npmCommand": [
    "bun"
  ],
  "showHardwareCursor": true,
  "tuiMode": "fullscreen",
  "hideThinkingBlock": true,
  "doubleEscapeAction": "tree",
  "treeFilterMode": "all",
  "markdown": {
    "mermaid": "streaming"
  },
  "editorPaddingX": 0,
  "quietStartup": "header",
  "codemode": {
    "mode": "only",
    "inlineBudget": 6000
  },
  "archimedes.notify": {
    "delayMs": 10000
  },
  "enabledModels": []
}
